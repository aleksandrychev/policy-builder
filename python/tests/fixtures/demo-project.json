    {
      "id": "73c8fe6d-7e9c-4aaa-a46c-c2b242e5f494",
      "name": "Webserver",
      "bundle": "webserver",
      "path": "./webserver.cf",
      "blocks": [
        {
          "blockId": "install-package",
          "label": "Install web server package",
          "params": {
            "package_name": "$(common_vars.webserver_package)"
          },
          "condition": {
            "mode": "if",
            "kind": "class",
            "className": "webserver_role"
          },
          "instanceId": "f9c797ce-b43f-4c88-8195-d7ed8ece8686"
        },
        {
          "blockId": "remove-package",
          "label": "Remove conflicting Apache",
          "params": {
            "package_name": "apache2"
          },
          "condition": {
            "mode": "if",
            "kind": "class",
            "className": "webserver_role"
          },
          "instanceId": "c8cfaa1d-9461-4937-857c-30d2cbeb4964"
        },
        {
          "blockId": "render-template",
          "label": "Render nginx config",
          "params": {
            "destination": "/etc/nginx/nginx.conf",
            "template_content": "worker_processes {{{vars.common_vars.worker_processes}}};\n\nevents {\n    worker_connections {{{vars.common_vars.worker_connections}}};\n}\n\nhttp {\n    server {\n        listen 80;\n        server_name example.com;\n        root /var/www/html;\n    }\n}\n",
            "mode": "644",
            "owner": "root",
            "group": "root"
          },
          "instanceId": "23a481d9-1d03-403e-8e7e-eebaa152f1d6"
        },
        {
          "blockId": "manage-service",
          "label": "Restart nginx on config change",
          "params": {
            "service_name": "nginx",
            "action": "restart"
          },
          "instanceId": "10bd00a6-91bf-4434-95d2-85f7611839ab"
        },
        {
          "blockId": "remove-file",
          "label": "Remove default nginx site",
          "params": {
            "path": "/etc/nginx/sites-enabled/default"
          },
          "instanceId": "8ba088bc-cb51-4659-b0c6-a2837c3f345c"
        },
        {
          "blockId": "set-permissions",
          "label": "Lock down nginx config files",
          "params": {
            "path": "/etc/nginx/nginx.conf\n/etc/nginx/conf.d/default.conf",
            "mode": "644",
            "owner": "root",
            "group": "root"
          },
          "instanceId": "7715e0b0-b7d5-4000-b360-ca7500a9868b"
        },
        {
          "blockId": "manage-users",
          "label": "Create deploy user",
          "params": {
            "username": "deploy",
            "state": "present"
          },
          "instanceId": "b3dca036-f40e-40d8-be73-0f7a50858f3d"
        },
        {
          "blockId": "report-message",
          "label": "Report provisioning done",
          "params": {
            "message": "Web server provisioning complete"
          },
          "instanceId": "d7032692-9115-41fb-b288-be49b70ab929"
        }
