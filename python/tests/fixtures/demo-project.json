            {
              "valueSourceId": "file-lines",
              "params": {
                "variable_name": "worker_processes",
                "path": "/proc/cpuinfo",
                "comment": "",
                "split": "\\n",
                "max_entries": "1000",
                "max_bytes": "1048576"
