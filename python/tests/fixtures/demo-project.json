      "blocks": [
        {
          "blockId": "define-variable",
          "label": "Nginx settings",
          "params": {},
          "entries": [
            {
              "valueSourceId": "literal",
              "params": {
                "variable_name": "webserver_package",
                "value": "nginx"
              },
              "id": "84cd8d55-0d06-452d-8c5c-66951d706dc5"
            },
            {
              "valueSourceId": "file-lines",
              "params": {
                "variable_name": "worker_processes",
                "path": "/proc/cpuinfo",
                "comment": "",
                "split": "\\n",
                "max_entries": "1000",
                "max_bytes": "1048576"
              },
              "sampleInput": "processor\t: 0\nmodel name\t: Example CPU\nprocessor\t: 1\nmodel name\t: Example CPU",
              "decorators": [
                {
                  "id": "d75aa885-49b1-4218-9e55-e37a3fb9c693",
                  "decoratorId": "grep",
                  "params": {
                    "pattern": "processor.*"
