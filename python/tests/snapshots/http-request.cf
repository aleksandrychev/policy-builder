### example
  # Case 0
  http:
    "https://cfengine.com/images/cfengine-logo.svg"
      method => "GET",
      file => "/var/cfengine/logo.svg",
      headers => { "Accept: image/svg+xml" },
      insecure => "false";

### method = 'POST'
  # Case 1
  http:
    "https://cfengine.com/images/cfengine-logo.svg"
      method => "POST",
      file => "/var/cfengine/logo.svg",
      headers => { "Accept: image/svg+xml" },
      insecure => "false";

