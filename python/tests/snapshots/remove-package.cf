### example
  # Case 0
  packages:
    "telnet" policy => "absent";

### package_module = 'apt_get'
  # Case 1
  packages:
    "telnet"
      policy => "absent",
      package_module => default:apt_get;

### package_module = 'yum'
  # Case 2
