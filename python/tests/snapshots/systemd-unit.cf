### example
  # Case 0
  systemd:
    "myapp"
      state => "started",
      enabled => "true",
      daemon_reload => "false",
      unit_description => "My app",
      service_exec_start => { "/usr/bin/myapp --port 8080" },
      unit_after => { "network-online.target" };

### state = 'stopped'
  # Case 1
  systemd:
    "myapp"
      state => "stopped",
      enabled => "true",
      daemon_reload => "false",
      unit_description => "My app",
      service_exec_start => { "/usr/bin/myapp --port 8080" },
      unit_after => { "network-online.target" };

