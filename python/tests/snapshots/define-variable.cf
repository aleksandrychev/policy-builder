### source literal
    # Case 0
    "literal" string => "hello";

### source list
    # Case 1
    "list" slist => { "a", "b" };

### source per-condition
    # Case 2
    "per_condition"
      string => ifelse(
        "default:debian", "www-data", "default:redhat", "nginx", "nobody"
      );

### source structured-data-literal
    # Case 3
    "structured_data_literal" data => parsejson("{\"a\": 1}");

### source variable
    # Case 4
    "variable" string => "$(snap:vars.literal)";

### source list-variable
    # Case 5
    "list_variable" slist => { @(snap:vars.list) };

### source data-variable
    # Case 6
    "data_variable" data => mergedata("snap:vars.structured_data_literal");

### source command-output
    # Case 7
    "command_output"
      string => execresult("/bin/echo hello", "noshell", "stdout"),
      if => "agent";

### source file-lines
    # Case 8
    "file_lines"
      slist => readstringlist("/etc/hosts", "x", "\n", "1000", "1048576");

### source file-content
    # Case 9
    "file_content" string => readfile("/etc/hosts", "16384");

### source file-metadata
    # Case 10
    "file_metadata" string => filestat("/etc/hosts", "size");

### source environment-variable
    # Case 11
    "environment_variable" string => getenv("HOME", "1024");

### source structured-data-json
    # Case 12
    "structured_data_json" data => readjson("/etc/hosts", "1048576");
