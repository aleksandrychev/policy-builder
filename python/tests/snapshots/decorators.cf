### decorator data-field
    # Case 0
    # The JSON in /etc/hosts
    # → its field x
    "via_0__1" data => readjson("/etc/hosts", "1048576");
    "via_0" string => "$(snap:vars.via_0__1[x])";

### decorator data-keys
    # Case 1
    # The JSON in /etc/hosts
    # → its keys
    "via_1" slist => getindices(readjson("/etc/hosts", "1048576"));

### decorator data-length
    # Case 2
    # The JSON in /etc/hosts
    # → count its entries
    "via_2" int => length(readjson("/etc/hosts", "1048576"));

### decorator data-merge
    # Case 3
    # The JSON in /etc/hosts
    # → merged with {"a": 1}
    "via_3" data => mergedata(readjson("/etc/hosts", "1048576"), "{\"a\": 1}");

### decorator data-to-json
    # Case 4
    # The JSON in /etc/hosts
    # → as JSON text
    "via_4__1" data => readjson("/etc/hosts", "1048576");
    "via_4" string => format("%S", "snap:vars.via_4__1");

### decorator data-values
    # Case 5
    # The JSON in /etc/hosts
    # → its values
    "via_5" slist => getvalues(readjson("/etc/hosts", "1048576"));

### decorator default-if-empty
    # Case 6
    # The stdout of "/bin/echo hello"
    # → fall back to "none" if unset or "x"
    "via_6__in"
      string => execresult("/bin/echo hello", "noshell", "stdout"),
      if => "agent";

    "via_6"
      string => "$(snap:vars.via_6__in)",
      if => and(
        "agent",
        and(
          isvariable("snap:vars.via_6__in"),
          not(strcmp("$(snap:vars.via_6__in)", "x"))
        )
      );

    "via_6"
      string => "none",
      if => and("agent", not(isvariable("snap:vars.via_6")));

### decorator difference
    # Case 7
    # The lines of /etc/hosts
    # → remove x
    "via_7"
      slist => difference(
        readstringlist("/etc/hosts", "x", "\n", "1000", "1048576"), '["x"]'
      );

### decorator filter
    # Case 8
    # The lines of /etc/hosts
    # → filter entries on h.*
    "via_8"
      slist => filter(
        "h.*",
        readstringlist("/etc/hosts", "x", "\n", "1000", "1048576"),
        "true",
        "false",
        "1000"
      );

### decorator format
    # Case 9
    # The stdout of "/bin/echo hello"
    # → format as "%s"
    "via_9"
      string => format(
        "%s", execresult("/bin/echo hello", "noshell", "stdout")
      ),
      if => "agent";

### decorator grep
    # Case 10
    # The lines of /etc/hosts
    # → keep entries matching h.*
    "via_10"
      slist => grep(
        "h.*", readstringlist("/etc/hosts", "x", "\n", "1000", "1048576")
      );

### decorator join
    # Case 11
    # The lines of /etc/hosts
    # → join with ", "
    "via_11"
      string => join(
        ", ", readstringlist("/etc/hosts", "x", "\n", "1000", "1048576")
      );

### decorator lastnode
    # Case 12
    # The stdout of "/bin/echo hello"
    # → keep what follows the last "/"
    "via_12"
      string => lastnode(
        execresult("/bin/echo hello", "noshell", "stdout"), "/"
      ),
      if => "agent";

### decorator length
    # Case 13
    # The lines of /etc/hosts
    # → count the entries
    "via_13"
      int => length(readstringlist("/etc/hosts", "x", "\n", "1000", "1048576"));

### decorator maplist
    # Case 14
    # The lines of /etc/hosts
    # → map each entry to "h.*"
    "via_14"
      slist => maplist(
        "h.*", readstringlist("/etc/hosts", "x", "\n", "1000", "1048576")
      );

### decorator nth
    # Case 15
    # The lines of /etc/hosts
    # → take entry 0
    "via_15"
      string => nth(
        readstringlist("/etc/hosts", "x", "\n", "1000", "1048576"), "0"
      );

### decorator regex-replace
    # Case 16
    # The stdout of "/bin/echo hello"
    # → replace h.* with "x"
    "via_16"
      string => regex_replace(
        execresult("/bin/echo hello", "noshell", "stdout"), "h.*", "x", "x"
      ),
      if => "agent";

### decorator sort
    # Case 17
    # The lines of /etc/hosts
    # → sort (lex)
    "via_17"
      slist => sort(
        readstringlist("/etc/hosts", "x", "\n", "1000", "1048576"), "lex"
      );

### decorator split-list
    # Case 18
    # The stdout of "/bin/echo hello"
    # → split into a list on "\n"
    "via_18"
      slist => string_split(
        execresult("/bin/echo hello", "noshell", "stdout"), "\n", "1000"
      ),
      if => "agent";

### decorator string-downcase
    # Case 19
    # The stdout of "/bin/echo hello"
    # → lowercase
    "via_19"
      string => string_downcase(
        execresult("/bin/echo hello", "noshell", "stdout")
      ),
      if => "agent";

### decorator string-head
    # Case 20
    # The stdout of "/bin/echo hello"
    # → keep the first 9 characters
    "via_20"
      string => string_head(
        execresult("/bin/echo hello", "noshell", "stdout"), "9"
      ),
      if => "agent";

### decorator string-replace
    # Case 21
    # The stdout of "/bin/echo hello"
