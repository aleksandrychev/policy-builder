{
  "$schema": "./schemas/block-descriptor.v1.json",
  "schema_version": 1,
  "id": "install-package",
  "version": 1,
  "name": "Install Package",
  "category": "Packages",
  "description": "Ensures one or more packages are present.",
  "compile_target": "own_bundle",
  "steps": [
    {
      "promise_type": "packages",
      "promiser": "{{package_name}}",
      "attributes": {
        "policy": "present",
        "version": {
          "if_set": "version",
          "value": "{{version}}"
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "package_name",
      "label": "Package name",
      "type": "text",
      "required": true,
      "allow_list": true,
      "help": "One package per line."
    },
    {
      "name": "version",
      "label": "Version",
      "type": "string",
      "required": false,
      "default": "",
      "help": "Empty: any installed version will do. A version (e.g. 1.24.0-1) installs exactly that one, latest keeps it at the newest available. Applies to every package listed."
    }
  ]
}
