{
  "$schema": "./schemas/block-descriptor.v1.json",
  "schema_version": 1,
  "id": "copy-file",
  "version": 1,
  "name": "Copy File",
  "category": "Files",
  "description": "Copies a file from a source path known to the agent, enforcing permissions.",
  "compile_target": "own_bundle",
  "steps": [
    {
      "promise_type": "files",
      "promiser": "{{destination}}",
      "attributes": {
        "copy_from": {
          "if_set": "server",
          "value": {
            "body": "remote_dcp",
            "args": [
              "{{source}}",
              "{{server}}"
            ]
          },
          "else": {
            "body": "local_cp",
            "args": [
              "{{source}}"
            ]
          }
        },
        "perms": {
          "body": "mog",
          "args": [
            "{{mode}}",
            "{{owner}}",
            "{{group}}"
          ]
        }
      }
    }
  ],
  "parameters": [
    {
      "name": "destination",
      "label": "Destination path",
      "type": "string",
      "required": true,
      "path": "absolute"
    },
    {
      "name": "source",
      "label": "Source path",
      "type": "string",
      "required": true,
      "path": "absolute",
      "help": "An absolute path on this host, or on the server when one is given."
    },
    {
      "name": "server",
      "label": "From server",
      "type": "string",
      "required": false,
      "default": "",
      "help": "Copy from this host instead, e.g. $(sys.policy_hub), comparing content. Its cf-serverd must allow access to the source path (the hub's default policy shares /var/cfengine/masterfiles)."
    },
    {
      "name": "mode",
      "label": "Permissions",
      "type": "string",
      "required": true,
      "default": "644",
      "allowed_chars": "0-7"
    },
    {
      "name": "owner",
      "label": "Owner",
      "type": "string",
      "required": true,
      "default": "root"
    },
    {
      "name": "group",
      "label": "Group",
      "type": "string",
      "required": true,
      "default": "root"
    }
  ]
}
