{
  "name": "cfengine-policy-builder",
  "version": "1.2.6",
  "description": "CFEngine Policy Builder - visual CFEngine policy builder (Electron + React)",
  "author": {
    "name": "Northern.tech",
    "email": "contact@northern.tech"
  },
  "license": "SEE LICENSE IN LICENSE",
  "main": "./out/main/index.js",
  "private": true,
  "prettier": "@northern.tech/prettier-config/react.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run package:prepare && electron-builder --dir",
    "build:mac": "npm run package:prepare && electron-builder --mac",
    "build:win": "npm run package:prepare && electron-builder --win",
    "build:linux": "npm run package:prepare && electron-builder --linux",
    "package:prepare": "npm run backend:build && npm run build",
    "backend:sync": "uv sync --directory python",
    "backend:build": "uv run --directory python --group build pyinstaller --noconfirm cfpb-backend.spec",
    "backend:test": "uv run --directory python pytest",
    "backend:coverage": "uv run --directory python pytest --cov --cov-report=xml --cov-report=term:skip-covered",
    "backend:format": "uv run --directory python black .",
    "backend:format:check": "uv run --directory python black --check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run --project renderer --project components --project main",
    "test:fast": "vitest run --project renderer --project main",
    "test:coverage": "vitest run --project renderer --project components --project main --project integration --coverage",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project renderer --project main",
    "test:e2e": "electron-vite build && playwright test -c e2e/playwright.config.ts",
    "docs:screenshots": "electron-vite build && playwright test -c e2e/docs/playwright.config.ts",
    "docs:clips": "electron-vite build && CLIPS=1 playwright test -c e2e/docs/playwright.config.ts clips",
    "docs:blocks": "node scripts/docs-blocks.mjs ../documentation/content/policy-builder/blocks"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.15",
    "@dagrejs/dagre": "^3.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/red-hat-text": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.2.0",
    "@mui/x-tree-view": "^9.18.0",
    "@northern.tech/eslint-config": "^0.7.4",
    "@northern.tech/prettier-config": "^0.2.2",
    "@northern.tech/themes": "^0.18.2",
    "@playwright/test": "^1.65.1",
    "@reduxjs/toolkit": "^2.14.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@xyflow/react": "^13.0.1",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.0.1",
    "zod": "^4.6.7"
  }
}
