{
  "name": "cfengine-policy-builder",
  "version": "0.1.0",
  "description": "CFEngine Policy Builder - visual CFEngine policy builder (Electron + React)",
  "author": "Northern.tech",
  "license": "SEE LICENSE IN LICENSE",
  "main": "./out/main/index.js",
  "private": true,
  "prettier": "@northern.tech/prettier-config/react.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run package:prepare && electron-builder --dir",
    "build:mac": "npm run package:prepare && electron-builder --mac",
    "build:win": "npm run package:prepare && electron-builder --win",
    "build:linux": "npm run package:prepare && electron-builder --linux",
    "package:prepare": "npm run backend:build && npm run build",
    "backend:sync": "uv sync --directory python",
    "backend:build": "uv run --directory python --group build pyinstaller --noconfirm cfpb-backend.spec",
    "backend:test": "uv run --directory python pytest",
    "backend:format": "uv run --directory python black .",
    "backend:format:check": "uv run --directory python black --check .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "test": "vitest run --project renderer --project components --project main",
    "test:fast": "vitest run --project renderer --project main",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project renderer --project main",
    "test:e2e": "electron-vite build && playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@dagrejs/dagre": "^3.1.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/red-hat-text": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.2.0",
    "@mui/x-tree-view": "^9.14.0",
    "@northern.tech/themes": "^0.17.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@uiw/react-codemirror": "^4.25.11",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0"
  },
  "devDependencies": {
    "@northern.tech/eslint-config": "^0.7.1",
    "@northern.tech/prettier-config": "^0.2.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.16.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  }
}
